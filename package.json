{
  "name": "meridian-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian: an open, AI-ready layer alongside a histology lab's LIMS. Simulated data only.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "convert": "tsx scripts/convert.ts",
    "mcp": "tsx mcp/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "export:hf": "tsx scripts/export_hf_dataset.ts",
    "demo:walk": "tsx scripts/demo-walk.ts",
    "demo:walk:fx": "FX=all tsx scripts/demo-walk.ts",
    "test:count": "tsx scripts/test-count.ts",
    "demo:walk:viz": "VIZ=all tsx scripts/demo-walk.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@number-flow/react": "^0.6.2",
    "hono": "^4.13.13",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
